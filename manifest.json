{
  "manifest_version": 3,
  "name": "LTenOd - Universal Quiz Assistant",
  "version": "1.3.0",
  "description": "Asisten kuis otomatis & semi-otomatis cerdas berbasis multi-provider AI untuk portal praktikum dan ujian e-learning Universitas Gunadarma.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LTenOd Settings",
    "default_icon": "icon.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://praktikum.gunadarma.ac.id/*",
    "https://v-class.gunadarma.ac.id/*",
    "https://praktikum-iflab.gunadarma.ac.id/*",
    "http://praktikum-iflab.gunadarma.ac.id/*",
    "file:///*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://praktikum.gunadarma.ac.id/*",
        "https://v-class.gunadarma.ac.id/*",
        "https://praktikum-iflab.gunadarma.ac.id/*",
        "http://praktikum-iflab.gunadarma.ac.id/*",
        "file:///*"
      ],
      "js": [
        "scripts/adapters.js",
        "scripts/content.js"
      ],
      "css": [
        "styles/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
